#!/usr/bin/env bash
# Usage: bin/daemon start|stop|status|logs
#
# The per-host daemon, detached from the terminal that started it. Its
# state lives under ~/.local/state/code-gantry/daemon: a pid file, the
# daemon's own log, one log per bay, and the status file.
set -euo pipefail

HERE="$(cd "$(dirname "$0")/.." && pwd)"
STATE="$HOME/.local/state/code-gantry/daemon"
PIDFILE="$STATE/daemon.pid"
LOG="$STATE/daemon.log"
mkdir -p "$STATE"

alive() { [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; }

case "${1:-}" in
  start)
    if alive; then echo "daemon already running, pid $(cat "$PIDFILE")"; exit 0; fi
    [ -f "$HOME/.config/code-gantry/host.exs" ] || { echo "no host file at ~/.config/code-gantry/host.exs" >&2; exit 1; }
    cd "$HERE/daemon"
    MIX_ENV=prod mix compile >/dev/null
    nohup env MIX_ENV=prod elixir -S mix run --no-halt >> "$LOG" 2>&1 < /dev/null &
    echo $! > "$PIDFILE"
    echo "daemon started, pid $!; status in $STATE/status, log in $LOG"
    ;;
  stop)
    if alive; then kill "$(cat "$PIDFILE")"; rm -f "$PIDFILE"; echo "daemon stopped"; else echo "daemon not running"; fi
    ;;
  status)
    if alive; then cat "$STATE/status" 2>/dev/null || echo "running, no status written yet"; else echo "daemon not running"; fi
    ;;
  logs)
    tail -n 50 -f "$LOG"
    ;;
  *)
    echo "usage: bin/daemon start|stop|status|logs" >&2; exit 2
    ;;
esac
