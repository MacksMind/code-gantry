#!/usr/bin/env bash
# Usage: bin/daemon start|stop|status|peers|holds|runs|logs|retry <bay>|place <bay> <port-offset> [config]|pickup|nudge|reload|version
#
# The per-host daemon, detached from the terminal that started it. Its
# state lives under ~/.local/state/code_gantry/daemon: a pid file, the
# daemon's own log, one log per bay, the status file, and the node name
# and cookie that the verbs use to speak to it.
#
# Everything runs through `mise`, so both hosts are on the Erlang in
# `.tool-versions`. That is not a preference: distributed Erlang only
# connects across a narrow version window, and the machines' own packages
# are far enough apart that they cannot see each other at all.
#
# The node name comes from `address:` in the host file, which is untracked,
# so no host is named in this repository. A dotted address is a long name
# and a bare one is short, which is Erlang's own distinction. Long is what
# reaches another machine unaided; short works too when each host can
# resolve the other's bare hostname, and is what lets one daemon join a
# mesh without the other being restarted to match it. The two kinds cannot
# connect to each other, so every daemon in one mesh uses the same kind.
# The cookie is the only credential between daemons, so every host in one
# mesh holds the same cookie file.
set -euo pipefail

HERE="$(cd "$(dirname "$0")/.." && pwd)"
STATE="$HOME/.local/state/code_gantry/daemon"
PIDFILE="$STATE/daemon.pid"
LOG="$STATE/daemon.log"
COOKIE="$STATE/cookie"
HOSTFILE="$HOME/.config/code_gantry/host.exs"
mkdir -p "$STATE"

MISE="$(command -v mise || true)"
[ -n "$MISE" ] || MISE="$HOME/.local/bin/mise"
[ -x "$MISE" ] || { echo "mise not found; the pinned toolchain in .tool-versions is required" >&2; exit 1; }

# Must agree with Host.load!, which falls back to the short hostname.
address() {
  local a=""
  [ -f "$HOSTFILE" ] && a="$(sed -n 's/^[[:space:]]*address:[[:space:]]*"\([^"]*\)".*/\1/p' "$HOSTFILE" | head -1)"
  [ -n "$a" ] || a="$(hostname -s)"
  printf '%s' "$a"
}

# --name or --sname, and the name to go with it.
node_flags() {
  local a; a="$(address)"
  case "$a" in
    *.*) printf -- '--name %s@%s' "$1" "$a" ;;
    *)   printf -- '--sname %s' "$1" ;;
  esac
}

alive() { [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; }

# A verb spoken to the running daemon: one expression evaluated on its node.
rpc() {
  alive || { echo "daemon not running" >&2; exit 1; }
  local node; node="$(cat "$STATE/node" 2>/dev/null || true)"
  case "$node" in
    ""|nonode@nohost) echo "the running daemon has no node name; it predates the verbs — stop and start it once" >&2; exit 1 ;;
  esac
  # Spoken in the same dialect as the daemon actually running. A daemon
  # started before the mesh has a short node name and the Erlang its
  # machine packages, and a long-named caller on the pinned Erlang can
  # reach neither. So the caller is shaped from the node name on disk,
  # and every verb keeps working across a restart rather than only after
  # one.
  case "${node#*@}" in
    *.*) ( cd "$HERE/daemon" && "$MISE" exec -- elixir --name "ctl-$$@${node#*@}" \
             --cookie "$(cat "$COOKIE")" --rpc-eval "$node" "$1" ) ;;
    *)   elixir --sname "ctl-$$" --cookie "$(cat "$COOKIE")" --rpc-eval "$node" "$1" ;;
  esac
}

case "${1:-}" in
  start)
    if alive; then echo "daemon already running, pid $(cat "$PIDFILE")"; exit 0; fi
    [ -f "$HOME/.config/code_gantry/host.exs" ] || { echo "no host file at ~/.config/code_gantry/host.exs" >&2; exit 1; }
    if [ ! -f "$COOKIE" ]; then (umask 077; openssl rand -hex 16 > "$COOKIE"); fi
    cd "$HERE/daemon"
    MIX_ENV=prod "$MISE" exec -- mix compile >/dev/null
    # shellcheck disable=SC2046
    nohup env MIX_ENV=prod "$MISE" exec -- elixir $(node_flags code_gantry_daemon) \
      --cookie "$(cat "$COOKIE")" \
      -S mix run --no-halt >> "$LOG" 2>&1 < /dev/null &
    echo $! > "$PIDFILE"
    echo "daemon started, pid $!; status in $STATE/status, log in $LOG"
    ;;
  stop)
    # Waits for the VM to be gone: its node name stays registered until it
    # is, and a start in that window refuses the name.
    if alive; then
      pid="$(cat "$PIDFILE")"; kill "$pid"
      for _ in $(seq 1 60); do kill -0 "$pid" 2>/dev/null || break; sleep 0.5; done
      kill -0 "$pid" 2>/dev/null && { echo "daemon $pid did not exit in 30s" >&2; exit 1; }
      rm -f "$PIDFILE"; echo "daemon stopped"
    else echo "daemon not running"; fi
    ;;
  status)
    # Asked of the running daemon, which answers for every host that has
    # joined the mesh. The file is this host's own and is the fallback
    # when nothing is running to ask.
    if alive; then
      rpc "IO.puts CodeGantryDaemon.Control.status()" 2>/dev/null \
        || cat "$STATE/status" 2>/dev/null \
        || echo "running, no status written yet"
    else cat "$STATE/status" 2>/dev/null || echo "daemon not running"; fi
    ;;
  peers)
    rpc "IO.puts CodeGantryDaemon.Control.peers()"
    ;;
  nudge)
    rpc "IO.puts CodeGantryDaemon.Control.nudge()"
    ;;
  holds)
    rpc "IO.puts CodeGantryDaemon.Control.holds()"
    ;;
  runs)
    rpc "IO.puts CodeGantryDaemon.Control.runs()"
    ;;
  logs)
    tail -n 50 -f "$LOG"
    ;;
  retry)
    [ -n "${2:-}" ] || { echo "usage: bin/daemon retry <bay>" >&2; exit 2; }
    rpc "IO.puts CodeGantryDaemon.Control.retry(\"$2\")"
    ;;
  version)
    rpc "IO.puts CodeGantryDaemon.Control.version()"
    ;;
  pickup)
    rpc "IO.puts CodeGantryDaemon.Control.pickup()"
    ;;
  reload)
    rpc "IO.puts CodeGantryDaemon.Control.reload()"
    ;;
  place)
    [ -n "${2:-}" ] && [ -n "${3:-}" ] || { echo "usage: bin/daemon place <bay> <port-offset> [config-path-in-the-checkout]" >&2; exit 2; }
    [[ "$3" =~ ^[0-9]+$ ]] || { echo "the port offset must be a whole number" >&2; exit 2; }
    if [ -n "${4:-}" ]; then rpc "IO.puts CodeGantryDaemon.Control.place(\"$2\", $3, \"$4\")"; else rpc "IO.puts CodeGantryDaemon.Control.place(\"$2\", $3)"; fi
    ;;
  *)
    echo "usage: bin/daemon start|stop|status|peers|holds|runs|logs|retry <bay>|place <bay> <port-offset> [config]|pickup|nudge|reload|version" >&2; exit 2
    ;;
esac
