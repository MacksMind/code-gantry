#!/usr/bin/env bash
# Usage: bin/daemon start|stop|status|logs|retry <bay>|place <bay> <port-offset> [scope-key ...]|scope <bay> [key ...]
#
# The per-host daemon, detached from the terminal that started it. Its
# state lives under ~/.local/state/code_gantry/daemon: a pid file, the
# daemon's own log, one log per bay, the status file, and the node name
# and cookie that `retry` uses to speak to it — a distributed-Erlang call
# into the running daemon, which is how a mesh will reach it later.
set -euo pipefail

HERE="$(cd "$(dirname "$0")/.." && pwd)"
STATE="$HOME/.local/state/code_gantry/daemon"
PIDFILE="$STATE/daemon.pid"
LOG="$STATE/daemon.log"
COOKIE="$STATE/cookie"
mkdir -p "$STATE"

alive() { [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; }

# A verb spoken to the running daemon: one expression evaluated on its node.
rpc() {
  alive || { echo "daemon not running" >&2; exit 1; }
  local node; node="$(cat "$STATE/node" 2>/dev/null || true)"
  case "$node" in
    ""|nonode@nohost) echo "the running daemon has no node name; it predates the verbs — stop and start it once" >&2; exit 1 ;;
  esac
  exec elixir --sname "ctl-$$" --cookie "$(cat "$COOKIE")" --rpc-eval "$node" "$1"
}

case "${1:-}" in
  start)
    if alive; then echo "daemon already running, pid $(cat "$PIDFILE")"; exit 0; fi
    [ -f "$HOME/.config/code_gantry/host.exs" ] || { echo "no host file at ~/.config/code_gantry/host.exs" >&2; exit 1; }
    if [ ! -f "$COOKIE" ]; then (umask 077; openssl rand -hex 16 > "$COOKIE"); fi
    cd "$HERE/daemon"
    MIX_ENV=prod mix compile >/dev/null
    nohup env MIX_ENV=prod elixir --sname code_gantry_daemon --cookie "$(cat "$COOKIE")" \
      -S mix run --no-halt >> "$LOG" 2>&1 < /dev/null &
    echo $! > "$PIDFILE"
    echo "daemon started, pid $!; status in $STATE/status, log in $LOG"
    ;;
  stop)
    if alive; then kill "$(cat "$PIDFILE")"; rm -f "$PIDFILE"; echo "daemon stopped"; else echo "daemon not running"; fi
    ;;
  status)
    if alive; then cat "$STATE/status" 2>/dev/null || echo "running, no status written yet"; else echo "daemon not running"; fi
    ;;
  logs)
    tail -n 50 -f "$LOG"
    ;;
  retry)
    [ -n "${2:-}" ] || { echo "usage: bin/daemon retry <bay>" >&2; exit 2; }
    rpc "IO.puts CodeGantryDaemon.Control.retry(\"$2\")"
    ;;
  scope)
    [ -n "${2:-}" ] || { echo "usage: bin/daemon scope <bay> [key ...]   (no keys: the whole plan)" >&2; exit 2; }
    KEYS=""
    for key in "${@:3}"; do KEYS="$KEYS\"$key\","; done
    rpc "IO.puts CodeGantryDaemon.Control.scope(\"$2\", [${KEYS%,}])"
    ;;
  place)
    [ -n "${2:-}" ] && [ -n "${3:-}" ] || { echo "usage: bin/daemon place <bay> <port-offset> [scope-key ...]" >&2; exit 2; }
    [[ "$3" =~ ^[0-9]+$ ]] || { echo "the port offset must be a whole number" >&2; exit 2; }
    SCOPE=""
    for key in "${@:4}"; do SCOPE="$SCOPE\"$key\","; done
    rpc "IO.puts CodeGantryDaemon.Control.place(\"$2\", $3, [${SCOPE%,}])"
    ;;
  *)
    echo "usage: bin/daemon start|stop|status|logs|retry <bay>|place <bay> <port-offset> [scope-key ...]|scope <bay> [key ...]" >&2; exit 2
    ;;
esac
