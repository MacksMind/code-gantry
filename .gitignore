.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# Run artifacts: state databases, logs, reports. Never committed.
runs/

# Per-project run state. `config.yaml` is versioned; these are not.
#
# flakes.md and stage-costs.md were tracked for a while and should not have
# been. Both are appended by a run, exactly as run.log is, and the fact that a
# later run reads them back does not make them source — state.db is read back
# too and has never been committed. Tracking them meant the working tree went
# dirty every time a stage landed or a flake was excused.
#
# approval.json especially: it records that a human read this machine's config
# and accepted the commands in it. Committing that would let a checkout arrive
# pre-approved, which is the one thing approval exists to prevent.
projects/*/approval.json
projects/*/status.md
projects/*/plan-snapshot/
projects/*/flakes.md
projects/*/stage-costs.md

# Run configs may carry sensitive paths; keep them out of history.
*.local.yaml
